---
import PageLayout from '../../layouts/PageLayout.astro';
import { posts, site } from '../../data/site';
import { postBodies } from '../../data/postBodies';

const mins = (slug: string) => Math.max(1, Math.round((postBodies[slug] ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length / 200));
const when = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const [lead, ...rest] = posts;
const arrow = 'M5 12h14M13 6l6 6-6 6';
const tel = `tel:${site.phone.replace(/[^0-9]/g, '')}`;
---
<PageLayout
  title="Health" accent="tips"
  eyebrow="Blog"
  lede="Simple advice from our therapists on pain, injuries and moving well. Short, clear and easy to use."
  description="Health tips and advice from the physical therapists at Performance Therapy Institute in Brentwood, Midtown Nashville and Nolensville, TN."
  image="/images/coolsprings/coolsprings-people-10.webp" sideImage="/images/coolsprings/coolsprings-people-10.webp" sideAlt="A therapist and patient reviewing an exercise plan in a bright clinic"
>
  <section class="section bg-cream">
    <div class="container-x">
      <a href={`/blog/${lead.slug}`} class="group grid overflow-hidden rounded-[10px] border border-navy/15 bg-white transition-all duration-500 hover:border-red hover:shadow-[0_40px_70px_-40px_rgba(20,33,61,.5)] lg:grid-cols-[1.1fr_1fr]" data-reveal>
        <span class="relative block min-h-[18rem] overflow-hidden">
          <img src={lead.image} alt="" width="1200" height="900" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" />
        </span>
        <span class="flex flex-col justify-center p-8 md:p-12">
          <span class="eyebrow">Latest article</span>
          <span class="font-display mt-4 block text-3xl leading-tight text-navy md:text-4xl">{lead.title}</span>
          <span class="mt-4 block text-[17px] leading-relaxed text-muted">{lead.excerpt}</span>
          <span class="mt-5 block text-sm text-navy/60">{lead.category} · {mins(lead.slug)} min read</span>
          <span class="btn btn-ghost-dark mt-7 self-start">Read article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </span>
      </a>

      <ul class="mt-6 grid gap-6 md:grid-cols-3" role="list">
        {rest.map((p, k) => (
          <li data-reveal style={`--d:${k * 90}ms`}>
            <a href={`/blog/${p.slug}`} class="group flex h-full flex-col overflow-hidden rounded-[10px] border border-navy/15 bg-white transition-all duration-500 hover:-translate-y-1 hover:border-red hover:shadow-[0_30px_50px_-30px_rgba(20,33,61,.45)]">
              <span class="block overflow-hidden"><img src={p.image} alt="" loading="lazy" width="800" height="600" class="aspect-[4/3] w-full object-cover transition-transform duration-[1100ms] group-hover:scale-[1.05]" /></span>
              <span class="flex flex-1 flex-col p-6">
                <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-red">{p.category}</span>
                <span class="font-display mt-2 block text-[1.35rem] leading-snug text-navy">{p.title}</span>
                <span class="mt-3 block text-[15px] leading-relaxed text-muted">{p.excerpt}</span>
                <span class="mt-auto block pt-5 text-sm text-navy/60">{mins(p.slug)} min read</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-spot class="section grain relative isolate overflow-hidden bg-navy-deep text-white" style="--glow: rgba(255,126,134,.12)">
    <div class="spot-dots text-white/40" aria-hidden="true"></div>
    <div class="spot-glow" aria-hidden="true"></div>
    <div class="container-x relative z-10 mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow eyebrow-light">Have a question?</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-5xl">Pain that won't go away? <em class="text-[#FF7E86]">Let's look at it.</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/70">Articles help, but a therapist can tell you what is going on in your body. Request a visit and we will build a plan for you.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={site.bookingUrl} class="btn btn-red">Request an Appointment</a>
        <a href={tel} class="btn btn-ghost-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</PageLayout>
