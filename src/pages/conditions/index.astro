---
import PageLayout from '../../layouts/PageLayout.astro';
import { conditions, conditionGroups } from '../../data/conditions';
---
<PageLayout title="Conditions we treat">
  <div class="mx-auto max-w-7xl px-4 py-16">
    {conditionGroups.map((g) => (
      <div class="mb-10">
        <h2 class="text-2xl font-semibold">{g.title}</h2>
        <ul class="mt-3 grid gap-3 md:grid-cols-3">
          {conditions.filter((c) => c.group === g.slug).map((c) => (
            <li><a class="block rounded border p-4" href={`/conditions/${c.slug}`}>{c.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</PageLayout>
