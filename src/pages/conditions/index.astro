---
import PageLayout from '../../layouts/PageLayout.astro';
import { conditionPages } from '../../data/conditionPages';
import { site } from '../../data/site';

const cats: Record<string, string> = {
  als: 'neuro', 'balance-disorders': 'neuro', dizziness: 'neuro', 'multiple-sclerosis': 'neuro',
  'breast-cancer-rehabilitation': 'cancer',
};
const catLabel: Record<string, string> = { pain: 'Pain and injury', neuro: 'Balance and nerves', cancer: 'Cancer care' };
const items = conditionPages
  .filter((p) => (p.base ?? 'conditions') === 'conditions')
  .map((p) => ({ ...p, cat: cats[p.slug] ?? 'pain' }))
  .sort((a, b) => a.title.localeCompare(b.title));
const chips = [['all', 'All conditions'], ['pain', 'Pain and injury'], ['neuro', 'Balance and nerves'], ['cancer', 'Cancer care']];
const tel = `tel:${site.phone.replace(/[^0-9]/g, '')}`;
---
<PageLayout
  title="Conditions" accent="we treat"
  eyebrow="What we treat"
  lede="From a sore ankle to a long-term illness, our therapists give you one-on-one, hands-on care. Pick your condition to see how we can help."
  description="Conditions treated at Performance Therapy Institute in Brentwood, Midtown Nashville and Nolensville, TN: ankle pain, arthritis, back pain, balance disorders, ALS, multiple sclerosis and more."
  image="/images/brentwood/brentwood-people-08.webp" sideImage="/images/brentwood/brentwood-people-08.webp" sideAlt="A therapist helping a patient walk with a walker and safety harness"
>
  <section class="section bg-cream">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow">{items.length} conditions</p>
          <h2 class="mt-5 text-4xl font-medium leading-[1.06] text-navy md:text-5xl">Find your <em class="text-red">condition.</em></h2>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter conditions" id="chips">
          {chips.map(([k, l], i) => (
            <button type="button" data-chip={k} aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-[6px] border border-navy/25 px-4 py-2 text-sm font-semibold text-navy transition hover:border-red aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white">{l}</button>
          ))}
        </div>
      </div>

      <ul id="grid" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {items.map((c, k) => (
          <li data-cat={c.cat} data-reveal style={`--d:${(k % 3) * 90}ms`}>
            <a href={`/conditions/${c.slug}`} class="group flex h-full flex-col overflow-hidden rounded-[10px] border border-navy/15 bg-white transition-all duration-500 hover:-translate-y-1 hover:border-red hover:shadow-[0_30px_50px_-30px_rgba(20,33,61,.45)]">
              <div class="relative overflow-hidden">
                <img src={c.images[0].src} alt={c.images[0].alt} loading="lazy" width="900" height="600" class="aspect-[3/2] w-full object-cover transition-transform duration-[1100ms] group-hover:scale-[1.05]" />
                <span class="absolute left-4 top-4 rounded-md bg-white/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-navy">{catLabel[c.cat]}</span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-2xl text-navy">{c.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{c.lede}</p>
                <span class="btn btn-ghost-dark mt-5 self-start !min-h-[40px] !px-4 !py-2 text-sm">See how we help <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p id="empty" class="mt-10 hidden text-center text-lg text-muted">No conditions in this group yet.</p>
    </div>
  </section>

  <section data-spot class="section grain relative isolate overflow-hidden bg-navy-deep text-white" style="--glow: rgba(255,126,134,.12)">
    <div class="spot-dots text-white/40" aria-hidden="true"></div>
    <div class="spot-glow" aria-hidden="true"></div>
    <div class="container-x relative z-10 mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow eyebrow-light">Not sure where to start?</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-5xl">Don't see your condition? <em class="text-[#FF7E86]">Just ask.</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/70">We treat many more conditions than the ones listed here. Tell us what hurts and a therapist will help you find the right plan.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={site.bookingUrl} class="btn btn-red">Request an Appointment</a>
        <a href={tel} class="btn btn-ghost-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const cards = [...document.querySelectorAll<HTMLElement>('#grid [data-cat]')];
  const empty = document.getElementById('empty');
  chips.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.chip;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let n = 0;
    cards.forEach((c) => { const show = k === 'all' || c.dataset.cat === k; c.classList.toggle('hidden', !show); if (show) n++; });
    empty?.classList.toggle('hidden', n > 0);
  }));
</script>
