---
import PageLayout from '../layouts/PageLayout.astro';
import { reviews } from '../data/testimonials';
import { site } from '../data/site';

const tel = `tel:${site.phone.replace(/[^0-9]/g, '')}`;
const star = 'M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z';
---
<PageLayout
  title="Patient" accent="reviews"
  eyebrow="Reviews"
  lede="Real words from real patients across Brentwood, Nashville and Nolensville. Every review below was shared by someone we helped."
  description="Patient reviews of Performance Therapy Institute in Brentwood, Midtown Nashville and Nolensville, TN."
  image="/images/coolsprings/coolsprings-people-19.webp" sideImage="/images/coolsprings/coolsprings-people-19.webp" sideAlt="A smiling patient during a visit at Performance Therapy Institute"
>
  <section class="section bg-cream">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{reviews.length} reviews</p>
        <h2 class="mt-5 text-4xl font-medium leading-[1.06] text-navy md:text-5xl">Real people. <em class="text-red">Real results.</em></h2>
      </div>

      <ul class="mt-12 gap-6 [column-fill:_balance] md:columns-2 lg:columns-3" role="list">
        {reviews.map((r) => (
          <li class="mb-6 break-inside-avoid" data-reveal>
            <figure class="rounded-[10px] border border-navy/15 bg-white p-7">
              <div class="flex gap-1 text-red" role="img" aria-label="5 out of 5 stars">
                {[0, 1, 2, 3, 4].map(() => <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={star} /></svg>)}
              </div>
              <blockquote class="mt-4">
                <p class="font-display text-[1.25rem] leading-snug text-navy">{r.quote}</p>
                {r.more && <p class="mt-3 text-[15px] leading-relaxed text-muted">{r.more}</p>}
              </blockquote>
              <figcaption class="mt-5 border-t border-navy/10 pt-4 text-sm">
                <span class="font-semibold text-navy">{r.name}</span>
                {(r.about || r.date) && <span class="block text-navy/55">{[r.about && `Care with ${r.about}`, r.date].filter(Boolean).join(' · ')}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-spot class="section grain relative isolate overflow-hidden bg-navy-deep text-white" style="--glow: rgba(255,126,134,.12)">
    <div class="spot-dots text-white/40" aria-hidden="true"></div>
    <div class="spot-glow" aria-hidden="true"></div>
    <div class="container-x relative z-10 mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow eyebrow-light">Your story is next</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-5xl">Ready to feel <em class="text-[#FF7E86]">like yourself again?</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/70">Treated by us already? We would love to hear how it went. Or start your own recovery today.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={site.bookingUrl} class="btn btn-red">Request an Appointment</a>
        <a href={tel} class="btn btn-ghost-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</PageLayout>
