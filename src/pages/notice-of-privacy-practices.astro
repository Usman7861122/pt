import LegalDoc from '../components/sections/LegalDoc.astro';
// DRAFT based on the standard HIPAA model notice. TODO: the clinic's privacy officer must review and confirm before launch.
const sections = [
  { id: 'notice', title: 'This notice', html: `<p><strong>This notice describes how medical information about you may be used and shared, and how you can get access to this information. Please read it carefully.</strong></p><p>Performance Therapy Institute, including its physical, occupational and speech therapists and staff at our Brentwood, Midtown Nashville, Nolensville and Lymphedema &amp; Cancer Care clinics, follows this notice.</p>` },
  { id: 'duties', title: 'Our duties', html: `<p>We are required by law to keep your health information private, to give you this notice of our legal duties and privacy practices, to follow the notice that is in effect, and to tell you if there is a breach that may have exposed your information.</p>` },
  { id: 'uses', title: 'How we may use and share your information', html: `<p>We may use and share your health information in these ways without your written permission:</p><ul><li><strong>For treatment.</strong> To plan and give your care, and to share information with your doctor and other providers who treat you.</li><li><strong>For payment.</strong> To bill and collect from you, your insurance or others, and to check your benefits.</li><li><strong>For health care operations.</strong> To run our practice, review the quality of care, train staff and meet legal duties.</li><li><strong>Appointment reminders</strong> and information about treatment options or other services that may help you.</li><li><strong>Business associates</strong> who do work for us and agree to protect your information.</li></ul>` },
  { id: 'other', title: 'Other times we may share information', html: `<p>The law allows or requires us to share information in some other cases, without your permission:</p><ul><li>When required by law, including to the Department of Health and Human Services.</li><li>For public health, such as reporting disease, injury or problems with a product.</li><li>To report suspected abuse, neglect or domestic violence.</li><li>For health oversight, such as audits and licensing.</li><li>For court orders, legal proceedings and some law enforcement requests.</li><li>To coroners, medical examiners and funeral directors.</li><li>For approved research.</li><li>To prevent a serious threat to health or safety.</li><li>For workers’ compensation, and for certain government functions.</li><li>To family or friends involved in your care, if you do not object or if you cannot decide and it is in your best interest.</li></ul>` },
  { id: 'authorization', title: 'When we need your written permission', html: `<p>We need your written permission for most uses of psychotherapy notes, for marketing, and for any sale of your health information. Other uses not covered by this notice also need your permission. You can cancel your permission in writing at any time, except for what we already did because of it.</p>` },
  { id: 'rights', title: 'Your rights', html: `<ul><li><strong>See and get a copy</strong> of your health records, in paper or electronic form. We may charge a reasonable fee.</li><li><strong>Ask us to correct</strong> information you believe is wrong or incomplete.</li><li><strong>Get a list</strong> of certain times we shared your information (an “accounting of disclosures”).</li><li><strong>Ask for limits</strong> on how we use or share your information. We do not have to agree, except when you pay in full out of pocket and ask us not to tell your health plan.</li><li><strong>Ask for private communication</strong>, for example by a different phone number or address.</li><li><strong>Get a paper copy</strong> of this notice at any time.</li><li><strong>Be told</strong> if there is a breach of your information.</li></ul><p>To use any of these rights, ask our front desk or the Privacy Officer below, in writing.</p>` },
  { id: 'complaints', title: 'Complaints', html: `<p>If you think your privacy rights were violated, you may complain to us or to the U.S. Department of Health and Human Services Office for Civil Rights. You will not be treated differently for filing a complaint.</p><p><strong>Privacy Officer</strong><br />Performance Therapy Institute<br />1646 Westgate Circle, Suite 106<br />Brentwood, TN 37027<br />Phone: 615-465-6810</p><p><strong>U.S. Department of Health and Human Services, Office for Civil Rights</strong><br />200 Independence Avenue, S.W., Washington, D.C. 20201<br />1-877-696-6775<br /><a href="https://www.hhs.gov/hipaa/filing-a-complaint/index.html" target="_blank" rel="noopener">hhs.gov/hipaa/filing-a-complaint</a></p>` },
  { id: 'changes', title: 'Changes to this notice', html: `<p>We may change this notice and the new terms will apply to all information we hold. The current notice is always on this page and at each clinic. <strong>Effective date: November 2, 2026.</strong></p>` },
];
