---
import PageLayout from '../../layouts/PageLayout.astro';
import LocalSection from '../../components/sections/LocalSection.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import { services } from '../../data/services';
import { localFor } from '../../data/local';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const c = service.content;
const local = localFor(service.title, 'service');
---
<PageLayout title={local.banner} eyebrow="Services" lede={c.intro} image={service.image}>
  <!-- Order: Overview, Is it right for you, LocalSection, Benefits, Recovery, Safety + FAQ, InTheNews, ServicesGrid -->
  <section class="py-16"><div class="mx-auto max-w-7xl px-4">
    <h2 class="text-2xl font-semibold">{c.whatIs.title}</h2>
    {c.whatIs.text.map((t) => <p class="mt-3">{t}</p>)}
  </div></section>
  <LocalSection topic={service.title} kind="service" />
  <section class="py-16"><div class="mx-auto max-w-7xl px-4"><h2 class="text-2xl font-semibold">{c.benefits.title}</h2></div></section>
  <section class="bg-bone py-16"><div class="mx-auto max-w-7xl px-4"><h2 class="text-2xl font-semibold">{c.recovery.title}</h2></div></section>
  <section class="py-16"><div class="mx-auto max-w-7xl px-4">
    <h2 class="text-2xl font-semibold">FAQ</h2>
    {c.faqs.map((f) => <details class="border-b py-3"><summary>{f.q}</summary><p class="mt-2">{f.a}</p></details>)}
  </div></section>
  <ServicesGrid exclude={service.slug} />
</PageLayout>
