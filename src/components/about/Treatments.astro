---
const tools = [
  { t: 'Laser therapy', d: 'Light energy that soothes pain and speeds up healing.', i: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z' },
  { t: 'Dry needling', d: 'Thin needles release tight muscle and calm deep pain.', i: 'M3 21l9-9M12 12l3-3 6-6M15 9l2 2' },
  { t: 'Shockwave therapy', d: 'Extracorporeal shockwave therapy for stubborn tendon and joint pain.', i: 'M2 12h3l2-6 4 12 3-9 2 3h6' },
  { t: 'Summus Medical Laser VitaBed', d: 'A laser bed that delivers calming, deep-reaching treatment.', i: 'M3 18h18M5 18v-5a2 2 0 012-2h10a2 2 0 012 2v5M7 11V8a2 2 0 012-2h6a2 2 0 012 2v3' },
  { t: 'Cupping', d: 'Gentle suction that loosens tight tissue and boosts blood flow.', i: 'M5 8h14l-1.500 9a3 3 0 01-3 2.500h-5A3 3 0 016.500 17L5 8zM4 8h16' },
];
---
<section data-spot class="section grain relative isolate overflow-hidden bg-navy-deep text-white" style="--glow: rgba(255,126,134,.12)">
  <div class="spot-dots text-white/40" aria-hidden="true"></div>
  <div class="spot-glow" aria-hidden="true"></div>
  <div class="container-x relative z-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end" data-reveal>
      <div>
        <p class="eyebrow eyebrow-light">Treatments</p>
        <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-6xl">Proven tools, <em class="text-[#FF7E86]">used with care.</em></h2>
      </div>
      <p class="max-w-lg text-lg leading-relaxed text-white/70 lg:justify-self-end">Your plan starts with hands-on therapy and exercise. When it helps, we add these treatments.</p>
    </div>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {tools.map((x, k) => (
        <li data-reveal style={`--d:${k * 80}ms`} class="group rounded-[10px] border border-white/15 bg-white/[.04] p-7 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-gold/70 hover:bg-white/[.08]">
          <span class="grid h-12 w-12 place-items-center rounded-[10px] border border-[#FF7E86]/60 bg-[#FF7E86]/10 text-[#FF7E86] transition-colors duration-300 group-hover:border-[#FF7E86] group-hover:bg-[#FF7E86] group-hover:text-navy-deep">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={x.i} /></svg>
          </span>
          <h3 class="font-display mt-6 text-2xl">{x.t}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-white/70">{x.d}</p>
        </li>
      ))}
      <li data-reveal style="--d:400ms" class="flex flex-col justify-between rounded-[10px] border border-gold/40 bg-gradient-to-br from-gold/20 to-transparent p-7">
        <p class="font-display text-2xl leading-snug">Not sure which treatment fits you?</p>
        <a href="/services" class="btn btn-ghost-light mt-8 self-start">See All Services</a>
      </li>
    </ul>
  </div>
</section>
