---
import TestimonialsCarousel from '../home/TestimonialsCarousel.tsx';
import { testimonials } from '../../data/site';
---
<section id="testimonials" data-spot class="section relative isolate overflow-hidden bg-navy text-white grain" style="--glow: rgba(255,126,134,.12)">
  <div class="spot-dots text-white/40" aria-hidden="true"></div>
  <div class="spot-glow" aria-hidden="true"></div>
  <p aria-hidden="true" class="font-display pointer-events-none absolute -right-4 -top-6 select-none text-[clamp(8rem,22vw,20rem)] italic leading-none text-white/[.035]">Kind words</p>
  <div class="container-x relative z-10">
    <div class="mb-12 max-w-2xl" data-reveal>
      <p class="eyebrow eyebrow-light">What our patients say</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-6xl">Real people. <em class="text-[#FF7E86]">Real results.</em></h2>
    </div>
    <TestimonialsCarousel client:visible items={testimonials} />
  </div>
</section>
