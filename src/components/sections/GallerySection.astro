---
import ImageGallery from '../ui/ImageGallery.tsx';
import { gallery } from '../../data/home';
const items = gallery.map((g) => ({ imgUrl: g.src, alt: g.alt, title: g.caption, subtitle: g.place }));
---
<section id="gallery" data-spot class="section relative isolate overflow-hidden bg-navy-deep text-white grain" style="--glow: rgba(183,157,110,.14)">
  <div class="spot-dots text-white/40" aria-hidden="true"></div>
  <div class="spot-glow" aria-hidden="true"></div>
  <div class="container-x relative z-10">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow eyebrow-light">Gallery</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] md:text-6xl">Step <em class="text-[#FF7E86]">inside</em> our clinics.</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/70">Hover over or tap a photo to open it up.</p>
    </div>
    <div class="mt-10 md:mt-14"><ImageGallery client:visible items={items} /></div>
  </div>
</section>
