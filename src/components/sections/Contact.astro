---
// "Get in touch" section on the home page. Every Book / Contact button points here (#contact).
import { site } from '../../data/site';
import { locations } from '../../data/home';
const tel = (p: string) => 'tel:' + p.replace(/[^0-9]/g, '');
const field = 'w-full rounded-[10px] border border-navy/20 bg-white px-4 py-3 text-navy outline-none transition focus:border-red focus:ring-2 focus:ring-red/30';
---
<section id="contact" class="section scroll-mt-20 bg-cream">
  <div class="container-x grid items-start gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-20">
    <div data-reveal>
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-5 text-4xl font-medium leading-[1.06] text-navy md:text-6xl">Ready to feel <em class="text-red">better?</em></h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-navy/75">Send us a note and our team will call you back to find a time that works. Or call the clinic nearest you.</p>
      <ul class="mt-9 divide-y divide-navy/10 border-y border-navy/10" role="list">
        {locations.map((l) => (
          <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-4">
            <div>
              <p class="font-display text-xl text-navy">{l.name}</p>
              <p class="text-[15px] text-muted">{l.address}, {l.city}</p>
            </div>
            <a href={tel(l.phone)} class="text-lg font-semibold text-navy hover:text-red">{l.phone}</a>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-[15px] text-muted">{site.hours}</p>
    </div>

    <form method="post" action={site.contactApi} class="grid gap-5 rounded-[10px] border border-navy/15 bg-white p-7 shadow-[0_40px_70px_-45px_rgba(20,33,61,.5)] md:p-10" data-reveal style="--d:120ms">
      <h3 class="font-display text-3xl text-navy">Request an appointment</h3>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-semibold text-navy">Full name<input name="name" required autocomplete="name" class={field} /></label>
        <label class="grid gap-1.5 text-sm font-semibold text-navy">Phone<input name="phone" type="tel" required autocomplete="tel" class={field} /></label>
      </div>
      <label class="grid gap-1.5 text-sm font-semibold text-navy">Email<input name="email" type="email" required autocomplete="email" class={field} /></label>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-semibold text-navy">Preferred clinic
          <select name="clinic" class={field}><option>Any clinic</option>{locations.map((l) => <option>{l.name}</option>)}</select>
        </label>
        <label class="grid gap-1.5 text-sm font-semibold text-navy">How can we help?
          <select name="reason" class={field}><option>Book an appointment</option><option>Ask a question</option><option>Check insurance</option><option>Send a referral</option></select>
        </label>
      </div>
      <label class="grid gap-1.5 text-sm font-semibold text-navy">Message<textarea name="message" rows="4" placeholder="Tell us a little about your pain or injury" class={field}></textarea></label>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <button type="submit" class="btn btn-red">Send message</button>
        <p class="text-sm text-muted">Please do not send private health details by form.</p>
      </div>
    </form>
  </div>
</section>
