---
import { team } from '../../data/home';
---
<section id="team" data-spot class="section relative isolate overflow-hidden bg-navy-deep text-white grain" style="--glow: rgba(183,157,110,.14)">
  <div class="spot-dots text-white/40" aria-hidden="true"></div>
  <div class="spot-glow" aria-hidden="true"></div>
  <p aria-hidden="true" class="font-display pointer-events-none absolute -right-6 top-10 select-none text-[clamp(9rem,24vw,22rem)] italic leading-none text-white/[.03]">Team</p>

  <div class="container-x relative z-10">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow eyebrow-light">Our team</p>
      <h2 class="mt-5 text-[clamp(2.6rem,4.8vw,4.6rem)] font-medium leading-[1.04] tracking-tight">The hands behind <em class="text-[#FF7E86]">your recovery.</em></h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/70">Doctors of physical therapy with more than 100 years of experience combined. Get to know some of the people who will care for you.</p>
    </div>

    <ul class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {team.map((m, k) => (
        <li data-reveal style={`--d:${(k % 3) * 120}ms`}>
          <a href={`/team/${m.name.toLowerCase().replace(/[^a-z]+/g,'-')}`} class="group block focus-visible:outline-offset-8" aria-label={`${m.name}, ${m.title}`}>
            <div class="relative overflow-hidden rounded-[10px] bg-navy shadow-[0_40px_70px_-35px_rgba(0,0,0,.8)]">
              {m.photo ? (
                <img src={m.photo} alt="" loading="lazy" width="800" height="800" class="img-sq !rounded-none grayscale-[.3] transition-all duration-[1100ms] ease-out group-hover:scale-[1.07] group-hover:grayscale-0" />
              ) : (
                <div class="grid aspect-square place-items-center bg-gradient-to-br from-navy to-navy-deep"><span class="font-display text-7xl text-white/80">{m.name.split(' ').map((p) => p[0]).slice(0, 2).join('')}</span></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/70 via-transparent to-transparent opacity-80 transition-opacity duration-700 group-hover:opacity-40"></div>
              <span aria-hidden="true" class="absolute inset-3 rounded-[6px] border border-white/0 transition-all duration-700 group-hover:inset-4 group-hover:border-white/50"></span>
              <span aria-hidden="true" class="absolute right-4 top-4 grid h-11 w-11 translate-y-2 place-items-center rounded-full bg-white text-navy opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7M8 7h9v9" /></svg>
              </span>
            </div>
            <div class="mt-5">
              <h3 class="font-display text-[1.75rem] font-medium leading-tight">{m.name}</h3>
              <p class="mt-1 text-xs uppercase tracking-[.2em] text-gold">{m.title}</p>
              <span aria-hidden="true" class="mt-4 block h-px w-10 bg-white/30 transition-all duration-700 group-hover:w-full group-hover:bg-gold"></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-16 text-center" data-reveal>
      <a href="/team" class="btn btn-red">Meet the Full Team</a>
    </div>
  </div>
</section>
