---
interface Props { title: string; accent?: string; eyebrow?: string; lede?: string; image?: string; imageAlt?: string; position?: string; sideImage?: string; sideAlt?: string; nearby?: string }
const { title, accent, eyebrow, lede, image, imageAlt = '', position = 'center', sideImage, sideAlt = '', nearby } = Astro.props;
---
<section data-spot class="grain relative isolate overflow-hidden bg-navy-deep pb-20 pt-44 text-white md:pb-28 md:pt-52" style="--glow: rgba(183,157,110,.16)">
  {image && !sideImage && <img src={image} alt={imageAlt} class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45" style={`object-position:${position}`} />}
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-deep via-navy-deep/80 to-navy-deep/30"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-navy-deep/80 to-transparent"></div>
  <div class="spot-dots text-white/40" aria-hidden="true"></div>
  <div class="spot-glow" aria-hidden="true"></div>
  <div class="container-x relative px-4">
   <div class={sideImage ? 'grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr] lg:gap-16' : ''}>
   <div>
    <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[.22em] text-white/60">
      <a href="/" class="hover:text-white">Home</a> <span class="mx-2 text-gold">/</span> <span class="text-white/90">{accent ? `${title} ${accent}` : title}</span>
    </nav>
    {eyebrow && <p class="eyebrow eyebrow-light mt-8">{eyebrow}</p>}
    <h1 class="mt-5 max-w-4xl text-[clamp(2.6rem,6vw,5.2rem)] font-medium leading-[1.04] tracking-tight">{accent ? <>{title}{" "}<em class="text-[#FF7E86]">{accent}</em></> : title}</h1>
    {lede && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75 md:text-xl" set:html={lede}></p>}
   </div>
   {sideImage && (
    <div class="relative">
      <div class="absolute -inset-3 rounded-[14px] border border-gold/40" aria-hidden="true"></div>
      <img src={sideImage} alt={sideAlt} class="relative block aspect-[4/3] w-full rounded-[10px] object-cover shadow-[0_40px_80px_-30px_rgba(0,0,0,.7)]" />
    </div>
   )}
   </div>
   {nearby && (
    <div class="mt-14 flex items-start gap-4 border-t border-white/15 pt-8">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 h-6 w-6 shrink-0 text-gold" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      <p class="max-w-4xl text-lg leading-relaxed text-white/70" set:html={nearby}></p>
    </div>
   )}
  </div>
</section>
