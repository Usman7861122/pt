---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string; eyebrow?: string; lede?: string; description?: string;
  image?: string; imageAlt?: string; position?: string; noindex?: boolean;
}
const { title, eyebrow, lede, description, image, imageAlt, position, noindex } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex} lightHero>
  <PageHero {title} {eyebrow} {lede} {image} imageAlt={imageAlt || `${title} at our clinic`} {position} />
  <slot />
</BaseLayout>
